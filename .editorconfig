# EditorConfig — https://editorconfig.org
# Matches the Prettier config (.prettierrc): 2-space indent, 100-col width,
# double quotes, LF endings, final newline.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2
max_line_length = 100

[*.md]
# Markdown uses two trailing spaces for hard line breaks.
trim_trailing_whitespace = false

[*.{yml,yaml}]
indent_size = 2
